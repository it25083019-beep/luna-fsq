GOOGLE_API_KEY=
# LLM backend: gemini | groq | ollama | openrouter | openai_compatible
LLM_PROVIDER=gemini
MODEL_NAME=gemini-2.5-flash

# --- Option A: Groq (free/fast, recommended when Gemini quota runs out) ---
# LLM_PROVIDER=groq
# OPENAI_API_KEY=gsk_xxx
# MODEL_NAME=llama-3.1-8b-instant

# --- Option B: Ollama local (no cloud quota) ---
# LLM_PROVIDER=ollama
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# MODEL_NAME=qwen2.5:7b

# --- Option C: OpenRouter / any OpenAI-compatible API ---
# LLM_PROVIDER=openrouter
# OPENAI_API_KEY=sk-or-v1-xxx
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# MODEL_NAME=openai/gpt-4o-mini

ADMIN_USER_IDS=admin_root
ENV=dev

# Local default
DATABASE_URL=sqlite:///./data/luna.db

# Render Postgres (Internal Database URL from dashboard):
# DATABASE_URL=postgresql://luna:PASSWORD@HOST/luna_fsq

# MySQL Workbench:
# DATABASE_URL=mysql+pymysql://luna:PASSWORD@127.0.0.1:3306/luna_fsq

JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=10080
ADMIN_EMAIL=admin@luna.local
ADMIN_PASSWORD=admin123456
# Set ADMIN_SYNC_PASSWORD=true to reset admin password from env on every startup
ADMIN_SYNC_PASSWORD=false
APP_BASE_URL=http://127.0.0.1:8006

# Optional SMTP for password reset emails (production)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_TLS=true
# PASSWORD_RESET_EXPIRE_MINUTES=60

ALLOWED_ORIGINS=*

# LUNA voice (Gemini TTS — warm Japanese female narrator)
LUNA_TTS_MODEL=gemini-2.5-flash-preview-tts
LUNA_TTS_VOICE=Leda
# Optional: set luna_gemini_voice=1 in browser localStorage to use Gemini TTS in chat

